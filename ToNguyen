<script>
const revealObserver = "IntersectionObserver" in window
 ? new IntersectionObserver(entries=>{
    entries.forEach(e=>{
      if(e.isIntersecting){
        e.target.classList.add("visible");
        revealObserver.unobserve(e.target);
      }
    });
  },{threshold:0.08})
 : null;

document.querySelectorAll(".reveal").forEach(el=>{
  if(revealObserver) revealObserver.observe(el);
  else el.classList.add("visible");
});

function scenario(index,button){
  const buttons=document.querySelectorAll(".scenario .choice");
  buttons.forEach(b=>{
    b.classList.remove("correct","wrong");
    b.disabled=true;
  });
  button.classList.add(index===1?"correct":"wrong");
  if(index!==1)buttons[1].classList.add("correct");
  document.getElementById("scenarioFeedback").textContent=
    index===1
    ?"✅ Chính xác! Hãy thể hiện sự đồng cảm, bảo vệ người bị tổn thương và báo cho người có trách nhiệm khi cần."
    :"❌ Chưa phù hợp. Cần tránh làm tổn thương hoặc lan truyền nội dung chế giễu người khác.";
}

const questions=[
  {
    q:"Đâu là ưu điểm của giao tiếp trong không gian mạng?",
    a:["Luôn bảo đảm thông tin chính xác","Kết nối nhanh dù ở xa","Không cần thiết bị","Không có rủi ro"],
    correct:1,
    explain:"Giao tiếp trực tuyến giúp kết nối nhanh chóng giữa những người ở nhiều địa điểm."
  },
  {
    q:"Hành vi nào thể hiện sự tôn trọng trên mạng?",
    a:["Công kích người có ý kiến khác","Đăng ảnh người khác không xin phép","Tranh luận lịch sự, có lý lẽ","Lan truyền tin đồn"],
    correct:2,
    explain:"Tranh luận lịch sự giúp duy trì môi trường giao tiếp văn minh."
  },
  {
    q:"Khi nhận được tin chưa được kiểm chứng, em nên làm gì?",
    a:["Chia sẻ ngay","Kiểm tra nguồn và độ tin cậy","Thêm nội dung gây sốc","Gửi cho tất cả bạn bè"],
    correct:1,
    explain:"Kiểm chứng thông tin trước khi chia sẻ giúp hạn chế tin giả."
  },
  {
    q:"Đâu là nguy cơ của giao tiếp trực tuyến?",
    a:["Tiết kiệm thời gian","Dễ trao đổi tài liệu","Lộ thông tin cá nhân","Học nhóm từ xa"],
    correct:2,
    explain:"Chia sẻ thông tin thiếu cẩn trọng có thể gây rủi ro về quyền riêng tư."
  },
  {
    q:"Khi bạn bè bị bắt nạt trên mạng, cách ứng xử nào phù hợp?",
    a:["Cổ vũ người bắt nạt","Phát tán bài viết xúc phạm","Phớt lờ trong mọi trường hợp","Động viên, hỗ trợ và báo người có trách nhiệm"],
    correct:3,
    explain:"Sự đồng cảm và hỗ trợ phù hợp góp phần tạo môi trường mạng an toàn."
  }
];

let current=0,score=0,answered=false;

function renderQuiz(){
  const area=document.getElementById("quizArea");
  const btn=document.getElementById("nextBtn");
  document.getElementById("quizFeedback").textContent="";
  document.getElementById("progressBar").style.width=
    (current/questions.length*100)+"%";

  if(current>=questions.length){
    document.getElementById("counter").textContent="Hoàn thành!";
    area.innerHTML='<h3>Kết quả học tập</h3><p id="score">'+score+'/'+questions.length+' câu đúng</p><p>'+
      (score===5?"Xuất sắc! Bạn đã nắm rất tốt nội dung ôn tập.":
       score>=3?"Khá tốt! Hãy ôn lại những câu chưa chính xác.":
       "Hãy xem lại phần lý thuyết và thử lại nhé!")+'</p>';
    document.getElementById("progressBar").style.width="100%";
    btn.style.display="none";
    return;
  }

  const item=questions[current];
  document.getElementById("counter").textContent=
    "Câu "+(current+1)+" / "+questions.length;
  area.innerHTML="";
  const title=document.createElement("p");
  title.className="question";
  title.textContent=item.q;
  area.appendChild(title);

  item.a.forEach((answer,i)=>{
    const label=document.createElement("label");
    label.className="option";
    const input=document.createElement("input");
    input.type="radio";input.name="answer";input.value=i;
    label.append(input,document.createTextNode(answer));
    area.appendChild(label);
  });
  btn.style.display="inline-block";
  btn.textContent="Kiểm tra đáp án";
  answered=false;
}

function nextQuestion(){
  if(answered){
    current++;
    renderQuiz();
    return;
  }
  const selected=document.querySelector('input[name="answer"]:checked');
  if(!selected){
    document.getElementById("quizFeedback").textContent=
      "⚠️ Vui lòng chọn một đáp án.";
    return;
  }
  const item=questions[current];
  const isCorrect=Number(selected.value)===item.correct;
  if(isCorrect)score++;
  document.querySelectorAll(".option").forEach((label,i)=>{
    label.querySelector("input").disabled=true;
    if(i===item.correct){
      label.style.borderColor="#34d399";
      label.style.background="#075e4b";
    }else if(i===Number(selected.value)){
      label.style.borderColor="#fb7185";
      label.style.background="#713044";
    }
  });
  document.getElementById("quizFeedback").textContent=
    (isCorrect?"✅ Chính xác! ":"❌ Chưa chính xác. ")+item.explain;
  answered=true;
  document.getElementById("nextBtn").textContent=
    current===questions.length-1?"Xem kết quả":"Câu tiếp theo →";
}

function resetQuiz(){
  current=0;score=0;answered=false;
  renderQuiz();
}
renderQuiz();
</script>
</body>
</html>
